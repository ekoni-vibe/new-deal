# DealRoom local runner credentials -- copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file (it's already in .gitignore).

# --- LLM parsing (js/parser.js relay + scripts/daily-agent-runner.js) ---
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=gemini

# --- Resend (email dispatch) ---
RESEND_API_KEY=
RESEND_FROM=deals@example.com

# --- Webflow (CMS push) ---
WEBFLOW_API_KEY=
WEBFLOW_COLLECTION_ID=
WEBFLOW_SITE_ID=

# --- NCND / teaser text ---
DEALROOM_FINDER_NAME=
DEALROOM_STATE=
